node_modules/
*.mp4
*.webm

# Per-app video workspaces: scratch state + snapshots, never tracked.
# Versioning for video work happens via .snapshots/ zips inside each folder.
# Exception: projects/README.md is documentation and stays tracked.
projects/*
!projects/README.md

# Agent tooling (regenerable via `npx remotion skills add`)
.agents/
.claude/
